/* ================ */
/* CSS Variables */
/* ================ */
:root {
  --primary: #111;
  --secondary: #d4af37;
  --text: #333;
  --light: #f9f9f9;
  --animation-duration: 0.8s;
  --animation-easing: cubic-bezier(0.4, 0, 0.2, 1);
}

/* ================ */
/* Base Styles */
/* ================ */
body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background-color: var(--light);
  color: var(--text);
  line-height: 1.6;
  opacity: 0;
  animation: fadeIn 1s ease forwards;
  animation-delay: 0.3s;
}

/* ================ */
/* Animations */
/* ================ */
@keyframes fadeIn {
  to {
    opacity: 1;
  }
}

@keyframes slideUpFadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Fade + slide-up animation for sections */
.section,
.hero {
  opacity: 0;
  animation: slideUpFadeIn var(--animation-duration) var(--animation-easing) forwards;
}

.section:nth-of-type(1) {
  animation-delay: 0.4s;
}
.section:nth-of-type(2) {
  animation-delay: 0.6s;
}
.hero {
  animation-delay: 0.2s;
}

/* ================ */
/* Header */
/* ================ */
header {
  background-color: var(--primary);
  color: white;
  padding: 1rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 100;
  animation: slideUpFadeIn 0.7s var(--animation-easing) forwards;
}

/* ================ */
/* Fonts for welcoming style */
/* ================ */
.hero h1 {
  font-family: 'Poppins', sans-serif;
  font-weight: 600;
  font-size: 2.8rem;
  margin-bottom: 1rem;
  color: var(--secondary);
  letter-spacing: 0.03em;
}

.hero p {
  font-family: 'Inter', sans-serif;
  font-size: 1.3rem;
  max-width: 600px;
  margin: 0 auto 2rem;
  color: white;
}

/* ================ */
/* Buttons */
/* ================ */
.cta-button {
  background-color: var(--secondary);
  color: var(--primary);
  padding: 0.8rem 2rem;
  border: none;
  border-radius: 4px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s;
  display: inline-block;
  cursor: pointer;
  user-select: none;
  box-shadow: 0 4px 8px rgba(212, 175, 55, 0.4);
}

.cta-button:hover,
.cta-button:focus {
  background-color: white;
  transform: translateY(-3px);
  box-shadow: 0 8px 16px rgba(212, 175, 55, 0.6);
}

/* Button pulse on hover */
.cta-button:hover {
  animation: pulseGlow 1.5s infinite alternate;
}

@keyframes pulseGlow {
  from {
    box-shadow: 0 8px 16px rgba(212, 175, 55, 0.6);
  }
  to {
    box-shadow: 0 12px 24px rgba(212, 175, 55, 0.9);
  }
}

/* ================ */
/* Services Section */
/* ================ */
.services li {
  background: #fff;
  padding: 1.5rem;
  border-radius: 8px;
  box-shadow: 0 2px 15px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s, box-shadow 0.3s;
  cursor: default;
}

.services li:hover,
.services li:focus-within {
  transform: translateY(-8px);
  box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
  outline: none;
}

/* Service icon pulse on hover */
.services li:hover .service-icon,
.services li:focus-within .service-icon {
  animation: pulseGlow 1.2s infinite alternate;
}

/* ================ */
/* Vehicle Selection Form */
/* ================ */
.vehicle-selection-form {
  background: #f1f5f9;
  padding: 1rem 1.5rem;
  border-radius: 6px;
  margin-bottom: 2rem;
  max-width: 400px;
  margin-left: auto;
  margin-right: auto;
  animation: slideUpFadeIn var(--animation-duration) var(--animation-easing) forwards;
  animation-delay: 0.8s;
}

.vehicle-selection-form h3 {
  margin-bottom: 0.8rem;
  text-align: center;
  color: #333;
  font-family: 'Poppins', sans-serif;
  font-weight: 600;
}

/* ================ */
/* Contact Info Section */
#contact-info {
  max-width: 400px;
  margin: 2rem auto;
  background: #fff;
  padding: 1.5rem 2rem;
  border-radius: 8px;
  box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  font-family: 'Inter', sans-serif;
  color: var(--text);
  animation: slideUpFadeIn var(--animation-duration) var(--animation-easing) forwards;
  animation-delay: 0.7s;
}

#contact-info h2 {
  font-family: 'Poppins', sans-serif;
  font-weight: 600;
  margin-bottom: 1rem;
  text-align: center;
  color: var(--primary);
}

#contact-info a {
  color: var(--secondary);
  text-decoration: none;
  font-weight: 600;
}

#contact-info a:hover {
  text-decoration: underline;
}

/* ================ */
/* Footer */
/* ================ */
footer {
  text-align: center;
  padding: 3rem 1rem;
  background-color: var(--primary);
  color: white;
  animation: slideUpFadeIn 0.7s var(--animation-easing) forwards;
}

.footer-content {
  max-width: 900px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
  text-align: left;
}

.footer-section h3 {
  color: var(--secondary);
  margin-bottom: 1rem;
}

.footer-section a {
  color: var(--secondary);
  text-decoration: none;
  font-weight: 600;
}

.footer-section a:hover {
  text-decoration: underline;
}

.social-links {
  display: flex;
  gap: 1rem;
  justify-content: center;
}

.social-links a {
  color: white;
  font-size: 1.5rem;
  transition: color 0.3s;
}

.social-links a:hover {
  color: var(--secondary);
}

.copyright {
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

/* ================ */
/* Mobile Styles */
/* ================ */
@media (max-width: 768px) {
  header {
    flex-direction: column;
    padding: 1rem;
  }

  nav {
    display: none;
    flex-direction: column;
    width: 100%;
    margin-top: 1rem;
  }

  nav.show {
    display: flex;
  }

  nav a {
    margin: 0.5rem 0;
    text-align: center;
  }

  .mobile-menu-btn {
    display: block;
  }

  .logo-container {
    height: 50px;
  }

  .logo {
    max-width: 150px;
  }

  .hero {
    padding: 3rem 1rem;
  }

  .hero h1 {
    font-size: 2rem;
  }

  .services ul {
    grid-template-columns: 1fr;
  }

  .calendly-inline-widget {
    height: 700px !important;
  }

  .footer-content {
    grid-template-columns: 1fr;
    text-align: center;
  }
}
