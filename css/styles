<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>T&D Details | Mobile Auto Detailing in RI</title>
  <meta name="description" content="T&D Details provides mobile auto detailing throughout Rhode Island. Interior, exterior, and maintenance services with easy online booking." />

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600&display=swap" rel="stylesheet" />

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

  <style>
    /* ================ */
    /* CSS Variables */
    /* ================ */
    :root {
      --primary: #111;
      --secondary: #d4af37;
      --text: #333;
      --light: #f9f9f9;
      --animation-duration: 0.8s;
      --animation-easing: cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* ================ */
    /* Base Styles */
    /* ================ */
    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background-color: var(--light);
      color: var(--text);
      line-height: 1.6;
      opacity: 0;
      animation: fadeIn 1s ease forwards;
      animation-delay: 0.3s;
    }

    @keyframes fadeIn {
      to {
        opacity: 1;
      }
    }

    @keyframes slideUpFadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Fade + slide-up animation for sections */
    .section, .hero {
      opacity: 0;
      animation: slideUpFadeIn var(--animation-duration) var(--animation-easing) forwards;
    }

    .section:nth-of-type(1) {
      animation-delay: 0.4s;
    }
    .section:nth-of-type(2) {
      animation-delay: 0.6s;
    }
    .hero {
      animation-delay: 0.2s;
    }

    /* ================ */
    /* Header */
    /* ================ */
    header {
      background-color: var(--primary);
      color: white;
      padding: 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
      animation: slideUpFadeIn 0.7s var(--animation-easing) forwards;
    }

    .logo-container {
      height: 60px;
    }

    .logo {
      height: 100%;
      max-width: 180px;
      width: auto;
      transition: transform 0.3s ease;
    }

    .logo:hover {
      transform: scale(1.05);
    }

    nav {
      display: flex;
      gap: 1.5rem;
    }

    nav a {
      color: white;
      text-decoration: none;
      font-weight: 600;
      transition: color 0.3s;
    }

    nav a:hover,
    nav a:focus {
      color: var(--secondary);
      outline: none;
    }

    /* Hidden checkbox for menu toggle */
    .menu-toggle {
      display: none;
    }

    /* Mobile menu button */
    .mobile-menu-btn {
      display: none;
      background: none;
      border: none;
      color: white;
      font-size: 1.8rem;
      cursor: pointer;
    }

    /* ================ */
    /* Hero Section */
    /* ================ */
    .hero {
      text-align: center;
      padding: 5rem 1rem;
      background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)),
                  url('https://images.unsplash.com/photo-1602332250027-b7c2d5e190ab') center/cover no-repeat;
      color: white;
    }

    .hero h1 {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 2.8rem;
      margin-bottom: 1rem;
      color: var(--secondary);
      letter-spacing: 0.03em;
    }

    .hero p {
      font-family: 'Inter', sans-serif;
      font-size: 1.3rem;
      max-width: 600px;
      margin: 0 auto 2rem;
      color: white;
    }

    /* ================ */
    /* Buttons */
    /* ================ */
    .cta-button {
      background-color: var(--secondary);
      color: var(--primary);
      padding: 0.8rem 2rem;
      border: none;
      border-radius: 4px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.3s;
      display: inline-block;
      cursor: pointer;
      user-select: none;
      box-shadow: 0 4px 8px rgba(212, 175, 55, 0.4);
    }

    .cta-button:hover,
    .cta-button:focus {
      background-color: white;
      transform: translateY(-3px);
      box-shadow: 0 8px 16px rgba(212, 175, 55, 0.6);
      animation: pulseGlow 1.5s infinite alternate;
      outline: none;
    }

    @keyframes pulseGlow {
      from {
        box-shadow: 0 8px 16px rgba(212, 175, 55, 0.6);
      }
      to {
        box-shadow: 0 12px 24px rgba(212, 175, 55, 0.9);
      }
    }

    /* ================ */
    /* Services Section */
    /* ================ */
    .section {
      padding: 3rem 1rem;
      max-width: 900px;
      margin: 0 auto;
    }

    .services li {
      background: #fff;
      padding: 1.5rem;
      border-radius: 8px;
      box-shadow: 0 2px 15px rgba(0,0,0,0.1);
      transition: transform 0.3s, box-shadow 0.3s;
      cursor: default;
      list-style: none;
    }

    .services li:hover,
    .services li:focus-within {
      transform: translateY(-8px);
      box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
      outline: none;
    }

    /* Service icon pulse on hover */
    .services li:hover .service-icon,
    .services li:focus-within .service-icon {
      animation: pulseGlow 1.2s infinite alternate;
    }

    .service-icon {
      font-size: 1.5rem;
      color: var(--secondary);
      margin-bottom: 0.5rem;
      display: inline-block;
    }

    /* ================ */
    /* Footer */
    /* ================ */
    footer {
      text-align: center;
      padding: 3rem 1rem;
      background-color: var(--primary);
      color: white;
      animation: slideUpFadeIn 0.7s var(--animation-easing) forwards;
    }

    /* ================ */
    /* Responsive */
    /* ================ */
    @media (max-width: 768px) {
      header {
        flex-direction: column;
        padding: 1rem;
      }

      nav {
        display: none;
        flex-direction: column;
        width: 100%;
        margin-top: 1rem;
        gap: 1rem;
      }

      /* Show nav when checkbox is checked */
      .menu-toggle:checked + .mobile-menu-btn + nav {
        display: flex;
      }

      .mobile-menu-btn {
        display: block;
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="logo-container">
      <img src="logo.png" alt="T&D Details Logo" class="logo" />
    </div>

    <!-- Hidden checkbox to toggle menu -->
    <input type="checkbox" id="menu-toggle" class="menu-toggle" />

    <!-- Label styled as hamburger button -->
    <label for="menu-toggle" class="mobile-menu-btn" aria-label="Toggle navigation menu" role="button" tabindex="0">
      <i class="fas fa-bars"></i>
    </label>

    <nav>
      <a href="#services">Services</a>
      <a href="#booking">Book Now</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <section class="hero">
    <h1>Welcome to T&D Details</h1>
    <p>Your mobile auto detailing solution in Rhode Island — interior, exterior, and maintenance services, with easy online booking.</p>
    <a href="#booking" class="cta-button">Book Your Service</a>
  </section>

  <section id="services" class="section services">
    <h2>Our Services</h2>
    <ul>
      <li tabindex="0">
        <span class="service-icon"><i class="fas fa-car-side"></i></span>
        <strong>Interior Detailing</strong>
        <p>Deep cleaning, vacuuming, and shampooing to restore your vehicle's interior.</p>
      </li>
      <li tabindex="0">
        <span class="service-icon"><i class="fas fa-spray-can"></i></span>
        <strong>Exterior Wash & Wax</strong>
        <p>Protective waxing and hand wash for a brilliant shine.</p>
      </li>
      <li tabindex="0">
        <span class="service-icon"><i class="fas fa-tools"></i></span>
        <strong>Maintenance Services</strong>
        <p>Oil changes, tire rotations, and basic upkeep to keep your car running smoothly.</p>
      </li>
    </ul>
  </section>

  <footer>
    <p>&copy; 2025 T&D Details. All rights reserved.</p>
  </footer>
</body>
</html>
